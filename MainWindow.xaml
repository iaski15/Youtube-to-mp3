<Window x:Class="YoutubeToMp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="YouTube to MP3"
        Width="520" Height="592"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        AllowDrop="True" FontFamily="Segoe UI"
        DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#8A93A6"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C2330"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#242D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF4657" Offset="0"/>
                                        <GradientStop Color="#FF7B52" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="hover" CornerRadius="12" Background="#FFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.09"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#FF4657" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C7CEDB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="#141A25" BorderBrush="#262F3F" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1B2331"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#37455E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#10151F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#FF9C9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEF1F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#FF7B52"/>
        </Style>

        <ControlTemplate x:Key="SlickProgressBar" TargetType="ProgressBar">
            <Grid>
                <Border x:Name="PART_Track" Background="#1A212E" CornerRadius="4"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF4657" Offset="0"/>
                            <GradientStop Color="#FF7B52" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </ControlTemplate>

    </Window.Resources>

    <Border CornerRadius="14" Background="#0B0E14" BorderBrush="#1D2532" BorderThickness="1"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="46" Margin="14,10,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4657" Offset="0"/>
                                <GradientStop Color="#FF7B52" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE102;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YouTube to MP3" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="#98A2B5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main content -->
            <StackPanel Grid.Row="1" Margin="34,14,34,0">

                <TextBlock Text="Grab the audio."
                           FontSize="26" FontWeight="SemiBold" Foreground="#F2F4F8"/>
                <TextBlock Text="Paste a YouTube link and save it as a crisp 192 kbps MP3."
                           FontSize="12.5" Foreground="#8A93A6" Margin="0,6,0,0"/>

                <!-- URL input -->
                <Border Margin="0,20,0,0" Padding="14,0,8,0" CornerRadius="12"
                        Background="#131926" BorderBrush="#262F3F" BorderThickness="1">
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlBox" Grid.Column="0" Style="{StaticResource FlatTextBox}"
                                 KeyDown="UrlBox_KeyDown"/>
                        <TextBlock Text="https://www.youtube.com/watch?v=..." FontSize="13.5" Foreground="#4E5A70"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="1,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Width="76" Content="Paste" Click="Paste_Click"/>
                    </Grid>
                </Border>

                <!-- Video preview card -->
                <Border x:Name="VideoCard" Margin="0,14,0,0" CornerRadius="12" Background="#12161F"
                        BorderBrush="#222B3A" BorderThickness="1" Padding="10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="126" Height="71" CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="ThumbBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="VideoTitle" Text="" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E8ECF3" TextWrapping="Wrap" MaxHeight="38"
                                       TextTrimming="CharacterEllipsis" LineHeight="17"/>
                            <TextBlock x:Name="VideoAuthor" Text="" FontSize="11.5" Foreground="#8A93A6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actions -->
                <Button x:Name="ConvertButton" Margin="0,18,0,0" Style="{StaticResource PrimaryButton}"
                        Content="Convert to MP3" Click="Convert_Click"/>

                <Button x:Name="OpenFolderButton" Margin="0,12,0,0" Style="{StaticResource GhostButton}"
                        Content="Show in folder" Visibility="Collapsed" Click="OpenFolder_Click"/>

                <!-- Progress -->
                <StackPanel x:Name="ProgressSection" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhaseText" Grid.Column="0" Text="" FontSize="12.5" Foreground="#8A93A6"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1" Text="" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#E8ECF3"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadBar" Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100"
                                 Template="{StaticResource SlickProgressBar}"/>
                    <Button x:Name="CancelButton" Margin="0,10,0,0" Style="{StaticResource LinkButton}"
                            Content="Cancel" HorizontalAlignment="Right" Click="Cancel_Click"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock x:Name="StatusText" Margin="0,16,0,0" FontSize="12.5" Foreground="#66708A"
                           TextWrapping="Wrap" Text="Ready. Paste a link or drop one anywhere in this window."/>

                <TextBlock Text="You can also drag a link straight onto the window."
                           FontSize="11" Foreground="#39415A" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="Converted locally on your machine - nothing leaves your PC."
                       FontSize="10.5" Foreground="#333C52" HorizontalAlignment="Center" Margin="0,0,0,14"/>
        </Grid>
    </Border>
</Window>
